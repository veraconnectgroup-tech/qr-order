{
  "id": "denis_short",
  "version": 1,
  "entry": "welcome",
  "nodes": {
    "welcome": {
      "on": {
        "ORDER": "collect",
        "BROWSE": "browse",
        "SMALLTALK": "welcome",
        "HANDOFF_WAITER": "handoff_waiter",
        "HANDOFF_PAY": "handoff_pay",
        "STATUS": "status"
      },
      "narrate": "template:welcome"
    },
    "collect": {
      "skills": ["cart.add_or_clarify"],
      "on": {
        "DRAFT_DRINKS_ONLY": "upsell_food",
        "DRAFT_HAS_FOOD": "collect",
        "DONE": "recap",
        "HANDOFF_WAITER": "handoff_waiter",
        "HANDOFF_PAY": "handoff_pay"
      }
    },
    "upsell_food": {
      "guard": "config.upsell.foodAfterDrinks",
      "skills": ["upsell.ask_food_once"],
      "on": {
        "DECLINE": "recap",
        "ORDER": "collect",
        "DONE": "recap",
        "HANDOFF_WAITER": "handoff_waiter",
        "HANDOFF_PAY": "handoff_pay"
      }
    },
    "recap": {
      "skills": ["cart.recap"],
      "on": {
        "CONFIRM": "submit",
        "ORDER": "collect",
        "HANDOFF_WAITER": "handoff_waiter",
        "HANDOFF_PAY": "handoff_pay"
      }
    },
    "submit": {
      "skills": ["order.submit"],
      "on": {
        "SUCCESS": "post_submit",
        "FAIL": "recap"
      }
    },
    "post_submit": {
      "on": {
        "ORDER": "collect",
        "STATUS": "status",
        "HANDOFF_WAITER": "handoff_waiter",
        "HANDOFF_PAY": "handoff_pay"
      },
      "narrate": "template:order_sent"
    },
    "browse": {
      "skills": ["browse.search"],
      "on": {
        "HANDOFF_WAITER": "handoff_waiter",
        "HANDOFF_PAY": "handoff_pay"
      }
    },
    "status": {
      "skills": ["status.table"],
      "on": {
        "HANDOFF_WAITER": "handoff_waiter",
        "HANDOFF_PAY": "handoff_pay"
      }
    },
    "handoff_waiter": {
      "skills": ["handoff.waiter"],
      "on": {
        "ORDER": "collect",
        "STATUS": "status"
      }
    },
    "handoff_pay": {
      "skills": ["handoff.payment"],
      "on": {
        "ORDER": "collect",
        "STATUS": "status"
      }
    }
  }
}
