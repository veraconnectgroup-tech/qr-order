{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vera Orders",
  "version": "0.1.0",
  "identifier": "de.verait.qrorder",
  "build": {
    "frontendDist": "https://qr-order-iota.vercel.app",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vera Orders",
        "url": "https://qr-order-iota.vercel.app/login",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
