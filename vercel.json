{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-closing",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/datev-monthly",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/fiscal-reconcile",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/fiscal-compliance",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/jobs/refresh-org-ai-ops",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/denis-nudge-digest",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/weekly-owner-report",
      "schedule": "0 20 * * 0"
    },
    {
      "path": "/api/cron/staff-training",
      "schedule": "30 7 * * 1"
    },
    {
      "path": "/api/cron/daily-prep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/dynamic-vkg",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/denis-experience-score",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/denis-session-watcher",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/denis-scheduler",
      "schedule": "*/5 * * * *"
    }
  ]
}
