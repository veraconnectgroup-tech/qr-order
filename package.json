{
  "name": "ordering",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify:denis": "vitest run src/__tests__/denis-architecture-compliance.test.ts",
    "eval:denis": "vitest run src/__tests__/denis-eval.test.ts",
    "eval:denis:record": "tsx scripts/record-denis-eval-run.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:load": "BASE_URL=$(node k6/resolve-base-url.mjs) k6 run k6/guest-flow.js",
    "test:load:smoke": "BASE_URL=$(node k6/resolve-base-url.mjs) k6 run k6/guest-flow-smoke.js",
    "test:load:burst": "BASE_URL=$(node k6/resolve-base-url.mjs) k6 run k6/webhook-burst.js",
    "test:load:sse": "BASE_URL=$(node k6/resolve-base-url.mjs) k6 run k6/sse-connections.js",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:push": "supabase db push",
    "db:types:remote": "supabase gen types typescript --linked > src/types/database.ts",
    "ai:grant-credits": "node scripts/grant-ai-credits.mjs",
    "push:generate-keys": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.53.1",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@stripe/terminal-js": "^0.26.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@upstash/qstash": "^2.11.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "babel-loader": "^10.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-pwa": "^5.6.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "@stripe/terminal-js>stripe": "22.1.1"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "sharp",
      "esbuild"
    ]
  }
}
